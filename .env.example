# CrewScope local source-development configuration.
# Production uses deploy/team-beta/.env.example plus file-backed Compose Secrets.
# For a complete browser-ready environment, prefer: ./deploy/team-beta/demo.sh up

# Database and Redis
CREWSCOPE_DB_URL=jdbc:postgresql://localhost:5432/crewscope
CREWSCOPE_DB_USERNAME=crewscope
CREWSCOPE_DB_PASSWORD=crewscope
CREWSCOPE_REDIS_URL=redis://localhost:6379

# Process role and local Agent state ownership
CREWSCOPE_SERVER_PORT=8080
CREWSCOPE_ENVIRONMENT=development
# server starts the API only. Use all only after configuring the Runtime identity block below.
CREWSCOPE_EXECUTION_PROFILE=server
CREWSCOPE_AGENT_EXECUTION_INSTANCE_ID=crewscope-local
CREWSCOPE_AGENT_EXECUTION_OWNERSHIP_SCOPE=local
CREWSCOPE_AGENT_EXECUTION_OWNERSHIP_LEASE=30s
CREWSCOPE_AGENT_EXECUTION_OWNERSHIP_RENEWAL=5s
CREWSCOPE_AGENT_STATE_WRITE_PROBE_TTL=10s

# Required credential encryption key ring.
# Generate once with: openssl rand -base64 32
# Then set CREWSCOPE_CREDENTIAL_KEYS to v1=<generated-value> and keep it stable across restarts.
CREWSCOPE_CREDENTIAL_CURRENT_KEY_ID=v1
CREWSCOPE_CREDENTIAL_KEYS=

# Runtime identity required by execution profiles all and worker.
# Organization and actor UUIDs must identify existing ACTIVE rows in the same Organization.
CREWSCOPE_RUNTIME_ORGANIZATION_ID=
CREWSCOPE_RUNTIME_ACTOR_PRINCIPAL_ID=
CREWSCOPE_RUNTIME_WORKER_STABLE_KEY=crewscope-local-worker

# Bootstrap compatibility and dedicated monitoring credentials
CREWSCOPE_BOOTSTRAP_USERNAME=crewscope
CREWSCOPE_BOOTSTRAP_PASSWORD=change-me
CREWSCOPE_MONITORING_USERNAME=crewscope-prometheus
CREWSCOPE_MONITORING_PASSWORD=change-me-monitoring

# Browser login and registration
# local + true enables the Vue login flow. bootstrap + false keeps an API-only compatibility process.
CREWSCOPE_SECURITY_MODE=bootstrap
CREWSCOPE_BROWSER_SESSION_ENABLED=false
CREWSCOPE_SESSION_TTL=12h
CREWSCOPE_MAXIMUM_SESSIONS=5
CREWSCOPE_SESSION_NAMESPACE=crewscope:session
# Keep false only for localhost. HTTPS deployments must use the Team Beta production profile.
CREWSCOPE_SESSION_COOKIE_SECURE=false
CREWSCOPE_REGISTRATION_MODE=OPEN
# OPEN registration remains unavailable until this points to an existing Organization.
CREWSCOPE_REGISTRATION_ORGANIZATION_ID=
CREWSCOPE_PASSWORD_HASH_PERMITS=2

# Optional local Operator upgrade. The Organization must already exist.
CREWSCOPE_OPERATOR_BOOTSTRAP_ENABLED=false
CREWSCOPE_OPERATOR_BOOTSTRAP_ORGANIZATION_ID=
CREWSCOPE_OPERATOR_BOOTSTRAP_USERNAME=crewscope-monitor
CREWSCOPE_OPERATOR_BOOTSTRAP_EMAIL=crewscope-monitor@crewscope.local
CREWSCOPE_OPERATOR_BOOTSTRAP_DISPLAY_NAME=CrewScope Operator

# Login admission defense is disabled for the API-only source profile. Enable it only after
# setting a stable Base64 key of at least 32 bytes (for example: `openssl rand -base64 32`).
CREWSCOPE_LOGIN_DEFENSE_ENABLED=false
CREWSCOPE_LOGIN_DEFENSE_ENVIRONMENT=development
CREWSCOPE_LOGIN_DEFENSE_HMAC_KEY_ID=v1
CREWSCOPE_LOGIN_DEFENSE_HMAC_KEY=
# Comma-separated CIDRs; forwarded headers are ignored unless the direct peer matches one.
CREWSCOPE_LOGIN_DEFENSE_TRUSTED_PROXIES=

# Team invitations. Keep the HMAC key stable while pending invitations exist.
CREWSCOPE_INVITATION_TOKEN_ENABLED=false
CREWSCOPE_INVITATION_TOKEN_HMAC_KEY=

# Durable Task tokens. When enabled, provide a stable Base64 key of at least 32 bytes.
CREWSCOPE_TASK_TOKEN_ENABLED=false
CREWSCOPE_TASK_TOKEN_ISSUER=crewscope
CREWSCOPE_TASK_TOKEN_CURRENT_KEY_ID=v1
CREWSCOPE_TASK_TOKEN_KEY_V1=

# Team Activity SSE cursor signatures. The exact variable name is part of the public config contract.
CREWSCOPE_TEAM_ACTIVITY_REALTIME_ENABLED=false
CREWSCOPE_TEAM_ACTIVITY_CURSOR_CURRENT_KEY_ID=v1
CREWSCOPE_TEAM_ACTIVITY_CURSOR_KEY_V1=

# Keep this random value stable so Coding Diff cursors survive local restarts.
# Generate with: openssl rand -hex 32
CREWSCOPE_CODING_DIFF_CURSOR_SECRET=

# Optional AgentScope bootstrap model. User/Team model connections are configured in the Web UI.
# DeepSeek and other OpenAI-compatible services use provider=openai with their HTTPS /v1 base URL.
OPENAI_API_KEY=
AGENTSCOPE_MODEL_PROVIDER=
AGENTSCOPE_OPENAI_ENABLED=true
AGENTSCOPE_OPENAI_MODEL_NAME=gpt-4.1-mini
AGENTSCOPE_OPENAI_BASE_URL=
# Leave empty to use AgentScope's default /chat/completions path.
AGENTSCOPE_OPENAI_ENDPOINT_PATH=
AGENTSCOPE_OPENAI_STREAM=true

# Coding Specialist overrides and optional offline dependency/Judge roots
CREWSCOPE_CODING_AGENT_TEMPERATURE=0
CREWSCOPE_CODING_AGENT_TOP_P=1
CREWSCOPE_CODING_AGENT_MAX_OUTPUT_TOKENS=8192
CREWSCOPE_CODING_SANDBOX_DEPENDENCY_CACHE_ROOT=
CREWSCOPE_CODING_SANDBOX_DEPENDENCY_CACHE_MOUNT=/maven-cache
CREWSCOPE_CODING_EVALUATION_JUDGE_TESTS_ROOT=

# GitHub Provider policy
# USER OAuth verification requires a token carrying the GitHub `repo` scope.
CREWSCOPE_GITHUB_ALLOW_BROAD_USER_OAUTH=true
