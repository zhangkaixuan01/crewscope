CREWSCOPE_DB_URL=jdbc:postgresql://localhost:5432/crewscope
CREWSCOPE_DB_USERNAME=crewscope
CREWSCOPE_DB_PASSWORD=crewscope
CREWSCOPE_SERVER_PORT=8080
CREWSCOPE_EXECUTION_PROFILE=all
CREWSCOPE_REDIS_URL=redis://localhost:6379
CREWSCOPE_ENVIRONMENT=development
CREWSCOPE_AGENT_EXECUTION_INSTANCE_ID=crewscope-local
CREWSCOPE_AGENT_EXECUTION_OWNERSHIP_LEASE=30s
CREWSCOPE_AGENT_EXECUTION_OWNERSHIP_RENEWAL=5s
CREWSCOPE_AGENT_STATE_WRITE_PROBE_TTL=10s
CREWSCOPE_BOOTSTRAP_USERNAME=crewscope
CREWSCOPE_BOOTSTRAP_PASSWORD=change-me
CREWSCOPE_SECURITY_MODE=bootstrap
CREWSCOPE_MONITORING_USERNAME=crewscope-prometheus
CREWSCOPE_MONITORING_PASSWORD=change-me-monitoring
# Browser Session is enabled only for the API/browser process; production HTTPS requires Secure.
CREWSCOPE_BROWSER_SESSION_ENABLED=false
CREWSCOPE_SESSION_TTL=12h
CREWSCOPE_MAXIMUM_SESSIONS=5
CREWSCOPE_SESSION_NAMESPACE=crewscope:session
CREWSCOPE_SESSION_COOKIE_SECURE=false
CREWSCOPE_REGISTRATION_MODE=OPEN
CREWSCOPE_REGISTRATION_ORGANIZATION_ID=
CREWSCOPE_OPERATOR_BOOTSTRAP_ENABLED=false
CREWSCOPE_OPERATOR_BOOTSTRAP_ORGANIZATION_ID=
CREWSCOPE_OPERATOR_BOOTSTRAP_USERNAME=crewscope-monitor
CREWSCOPE_OPERATOR_BOOTSTRAP_EMAIL=crewscope-monitor@crewscope.local
CREWSCOPE_OPERATOR_BOOTSTRAP_DISPLAY_NAME=CrewScope Operator
CREWSCOPE_PASSWORD_HASH_PERMITS=2
# Generate with: openssl rand -base64 32
CREWSCOPE_LOGIN_DEFENSE_ENABLED=false
CREWSCOPE_LOGIN_DEFENSE_ENVIRONMENT=development
CREWSCOPE_LOGIN_DEFENSE_HMAC_KEY_ID=v1
CREWSCOPE_LOGIN_DEFENSE_HMAC_KEY=
# Comma-separated CIDRs; forwarded headers are ignored unless the direct peer matches one.
CREWSCOPE_LOGIN_DEFENSE_TRUSTED_PROXIES=
CREWSCOPE_INVITATION_TOKEN_ENABLED=false
# Generate with: openssl rand -base64 32; keep stable while pending invitations exist.
CREWSCOPE_INVITATION_TOKEN_HMAC_KEY=
CREWSCOPE_TASK_TOKEN_ENABLED=false
CREWSCOPE_TASK_TOKEN_ISSUER=crewscope
CREWSCOPE_TASK_TOKEN_CURRENT_KEY_ID=v1
CREWSCOPE_TASK_TOKEN_KEY_V1=
OPENAI_API_KEY=
AGENTSCOPE_MODEL_PROVIDER=
AGENTSCOPE_OPENAI_ENABLED=true
AGENTSCOPE_OPENAI_MODEL_NAME=gpt-4.1-mini
AGENTSCOPE_OPENAI_BASE_URL=
AGENTSCOPE_OPENAI_ENDPOINT_PATH=
AGENTSCOPE_OPENAI_STREAM=true
CREWSCOPE_CODING_AGENT_TEMPERATURE=0
CREWSCOPE_CODING_AGENT_TOP_P=1
CREWSCOPE_CODING_AGENT_MAX_OUTPUT_TOKENS=8192
CREWSCOPE_CODING_SANDBOX_DEPENDENCY_CACHE_ROOT=
CREWSCOPE_CODING_SANDBOX_DEPENDENCY_CACHE_MOUNT=/maven-cache
CREWSCOPE_CODING_EVALUATION_JUDGE_TESTS_ROOT=
