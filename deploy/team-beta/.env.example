# Reference only: run quickstart.sh init, then edit the GENERATED .runtime/.env.
# Do not copy this file over .runtime/.env; it deliberately contains no encryption keys.
CREWSCOPE_WEB_PORT=8080
CREWSCOPE_REGISTRATION_MODE=OPEN
CREWSCOPE_DEMO_ORGANIZATION_NAME=CrewScope Team Beta

# Optional HTTPS reverse proxy settings (HTTP works without them).
CREWSCOPE_SESSION_COOKIE_SECURE=false
CREWSCOPE_HSTS_ENABLED=false
# CREWSCOPE_DOCKER_SOCKET=/var/run/docker.sock

# M10 knowledge & retrieval switches (all default false — the plain stack stays
# a normal PostgreSQL deployment with knowledge CRUD always available).
# Combination quick reference (M10 plan §10.7):
#   all off            — plain stack, knowledge management reads/writes, retrieval/injection
#                        answer explicit degraded codes, skill reads 200 / writes 422.
#   pgvector + index   — vector search ready; retrieval still needs its own switch.
#   index on, retrieval off — jobs build the index, preview answers degraded, skills usable.
#   retrieval on, memory off — search works, assistant memory stops writing.
#   retrieval off, skill on — catalog fully usable without search.
#   vector installed then switch off — the pgvector image stays (sticky marker); only the
#                        feature closes. An upgrade on top keeps flyway_vector_history.
# CREWSCOPE_PGVECTOR_ENABLED=false
# CREWSCOPE_KNOWLEDGE_INDEX_ENABLED=false
# CREWSCOPE_KNOWLEDGE_INDEX_WORKER_ENABLED=false
# CREWSCOPE_KNOWLEDGE_RETRIEVAL_ENABLED=false
# CREWSCOPE_KNOWLEDGE_INJECTION_ENABLED=false
# CREWSCOPE_SKILL_ENABLED=false
# CREWSCOPE_MEMORY_ENABLED=false

# M10 cost & quality observability.
# CREWSCOPE_BUDGET_ALERT_ENABLED=false
# CREWSCOPE_BUDGET_MONTHLY_TOKENS=0
# CREWSCOPE_OBSERVABILITY_REPORTING_ZONE=Asia/Shanghai

# The script generates CREWSCOPE_EXECUTION_ROOT and all passwords/signing/encryption keys.
# Keep those keys with your backup; changing them can make saved credentials unreadable.
