# Copy to a protected operator environment file. Secret values belong in CREWSCOPE_SECRETS_ROOT.
CREWSCOPE_BACKEND_IMAGE=registry.example.com/crewscope/backend@sha256:replace-with-64-hex-digest
CREWSCOPE_WEB_IMAGE=registry.example.com/crewscope/web@sha256:replace-with-64-hex-digest
CREWSCOPE_DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0@sha256:9e4b9e7517a6b660f2cc903a19b257b1852d5b3344794e3ea334ff00ae677ac2
CREWSCOPE_ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
CREWSCOPE_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1@sha256:d00a542e409ee618a4edc67da14dd48c5da66726bbd5537ab2af9c1dfc442c8a
CREWSCOPE_DATA_ROOT=/srv/crewscope
CREWSCOPE_SECRETS_ROOT=/etc/crewscope/secrets
CREWSCOPE_WEB_PORT=8080
# A second same-host restore Project must use a non-overlapping private subnet and matching Web IP.
CREWSCOPE_BACKEND_SUBNET=172.30.0.0/24
CREWSCOPE_WEB_INTERNAL_IP=172.30.0.10
CREWSCOPE_BOOTSTRAP_ORGANIZATION_ID=0198a475-0831-7000-8000-000000000001
CREWSCOPE_BOOTSTRAP_RUNTIME_PRINCIPAL_ID=0198a475-0831-7000-8000-000000000002
CREWSCOPE_BOOTSTRAP_ORGANIZATION_NAME="CrewScope Team Beta"
CREWSCOPE_REGISTRATION_MODE=INVITE_ONLY
CREWSCOPE_REGISTRATION_ORGANIZATION_ID=0198a475-0831-7000-8000-000000000001
# ADR-025 selects four bounded Argon2id operations for the 8C16G Team Beta host.
CREWSCOPE_PASSWORD_HASH_PERMITS=4

# Operator-only backup, restore and evidence coordinates.
CREWSCOPE_COMPOSE_PROJECT=crewscope-team-beta
CREWSCOPE_COMPOSE_PROFILE=
CREWSCOPE_COMPOSE_OVERLAY=
CREWSCOPE_BACKUP_ROOT=/srv/crewscope-backups
CREWSCOPE_BACKUP_PASSPHRASE_FILE=/etc/crewscope/secrets/backup_passphrase
CREWSCOPE_APPLICATION_VERSION=0.1.0-SNAPSHOT
CREWSCOPE_GIT_REVISION=replace-with-deployed-git-revision
CREWSCOPE_DATASET_VERSION=team-beta-v1
CREWSCOPE_DATASET_SEED=replace-with-dataset-seed
CREWSCOPE_RESTORE_MIN_SCHEMA=26
CREWSCOPE_RESTORE_MAX_SCHEMA=36
CREWSCOPE_RESTORE_TARGET_SCHEMA=36
