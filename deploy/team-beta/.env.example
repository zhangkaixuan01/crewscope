# Reference only: run quickstart.sh init, then edit the GENERATED .runtime/.env.
# Do not copy this file over .runtime/.env; it deliberately contains no encryption keys.
CREWSCOPE_WEB_PORT=8080
CREWSCOPE_REGISTRATION_MODE=OPEN
CREWSCOPE_DEMO_ORGANIZATION_NAME=CrewScope Team Beta

# Optional HTTPS reverse proxy settings (HTTP works without them).
CREWSCOPE_SESSION_COOKIE_SECURE=false
CREWSCOPE_HSTS_ENABLED=false
# CREWSCOPE_DOCKER_SOCKET=/var/run/docker.sock
# The script generates CREWSCOPE_EXECUTION_ROOT and all passwords/signing/encryption keys.
# Keep those keys with your backup; changing them can make saved credentials unreadable.
