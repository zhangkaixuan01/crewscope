{
  "name": "crewscope-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:m7-q03": "playwright test --config playwright.m7-q03.config.ts",
    "test:e2e:m7-q04-profiles": "playwright test --config playwright.m7-q04.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "vue-tsc --noEmit",
    "lint:eslint": "eslint src",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "format:check": "node ../scripts/check-web-quality.mjs",
    "check:sensitive": "node ../scripts/check-web-sensitive-fields.mjs",
    "check:enum-labels": "node ../scripts/check-web-enum-labels.mjs",
    "check:q01": "node ../scripts/check-m9-q01.mjs && node ../scripts/check-empty-states.mjs && node ../scripts/check-route-metadata.mjs && node ../scripts/check-disabled-reasons.mjs && node ../scripts/check-web-pagination.mjs && node ../scripts/check-dialog-focus.mjs && node ../scripts/check-config-form-tokens.mjs",
    "check:bundle": "node ../scripts/check-web-bundle-budget.mjs",
    "check:quality": "pnpm lint && pnpm lint:eslint && pnpm lint:style && pnpm format:check",
    "story": "histoire dev",
    "story:build": "histoire build"
  },
  "dependencies": {
    "@lucide/vue": "^1.29.0",
    "dompurify": "^3.4.13",
    "markdown-it": "^15.0.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.22",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.0",
    "histoire": "1.0.0-beta.1",
    "jsdom": "^30.0.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "pnpm@11.9.0"
}
