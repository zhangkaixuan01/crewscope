{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewscope.local/schemas/m4/real-model-run-lock-v1.schema.json",
  "title": "CrewScope M4 real model benchmark run lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "suiteVersion",
    "track",
    "runId",
    "startedAt",
    "provider",
    "modelId",
    "modelRevision",
    "seed",
    "temperature",
    "topP",
    "agentProfileVersion",
    "sandboxImage",
    "runtimeAssetSha256",
    "dependencyCacheSnapshotId",
    "dependencyCacheSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "crewscope.coding-real-model-run-lock/v1"},
    "suiteId": {"const": "crewscope-java-spring-coding"},
    "suiteVersion": {"const": "1.0.0"},
    "track": {"const": "real-model-benchmark"},
    "runId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 100},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 200},
    "modelRevision": {"type": "string", "minLength": 1, "maxLength": 200},
    "seed": {"enum": [20260816, 20260817, 20260818]},
    "temperature": {"const": 0},
    "topP": {"const": 1},
    "agentProfileVersion": {"const": "1.0.0"},
    "sandboxImage": {"const": "maven@sha256:29a1658b1f3078e07c2b17f7b519b45eb47f65d9628e887eac45a8c5c8f939d4"},
    "runtimeAssetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependencyCacheSnapshotId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "dependencyCacheSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
